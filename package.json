{
  "name": "ellencecil.com",
  "version": "0.0.1",
  "description": "Ellen Cecil-Lemkin's Professional Website",
  "repository": "https://github.com/Alemkin/ellencecil.com",
  "main": "/app",
  "author": "Alexander Lemkin",
  "scripts": {
