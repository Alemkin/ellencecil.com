    "identity-obj-proxy": "3.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "postcss-loader": "8.2.1",
    "sass": "^1.108.1",
    "sass-loader": "16.0.8",
    "snazzy": "8.0.0",
    "standard": "13.1.0",
    "stylelint": "10.1.0",
    "stylelint-config-standard": "18.3.0",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7",
    "webpack-node-externals": "1.7.2"
