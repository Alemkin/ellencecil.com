    "parser": "babel-eslint",
    "env": [
      "jest"
    ]
  },
  "dependencies": {
    "i18next": "17.0.6",
    "react": "16.10.2",
    "react-dom": "16.10.2",
    "react-router-dom": "5.1.2",
    "reactstrap": "8.0.1",
    "redux": "4.0.4"
  },
  "devDependencies": {
    "@babel/core": "7.5.5",
    "@babel/preset-env": "7.5.5",
    "@babel/preset-react": "7.0.0",
    "@babel/runtime": "7.5.5",
    "autoprefixer": "10.6.2",
    "babel-eslint": "10.0.2",
    "babel-loader": "8.4.1",
    "babel-plugin-transform-object-rest-spread": "7.0.0-beta.3",
    "bootstrap": "4.3.1",
    "circular-dependency-plugin": "5.0.2",
    "cross-env": "5.2.0",
    "css-loader": "7.1.5",
    "enzyme": "3.10.0",
